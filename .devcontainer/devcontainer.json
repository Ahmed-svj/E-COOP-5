{
  "name": "COOP (PHP 8.3 + MySQL 8)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [8080],
  "portsAttributes": { "8080": { "label": "COOP website", "onAutoForward": "openBrowser" } },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "nohup php -S 0.0.0.0:8080 -t public public/index.php > storage/logs/server.log 2>&1 &",
  "customizations": { "vscode": { "extensions": ["bmewburn.vscode-intelephense-client"] } }
}
